# Development defaults for media-service (loaded after the root .env).
PORT=4030
DATABASE_URL=postgres://a5:a5_dev_password@127.0.0.1:5432/a5_media

# Optional settings (defaults shown). Storage variables (STORAGE_DRIVER, STORAGE_LOCAL_ROOT,
# STORAGE_SIGNING_SECRET, S3_*) live in the root .env.
# PUBLIC_API_URL=            # public gateway origin for signed URLs; falls back to PUBLIC_APP_URL
# CDN_BASE_URL=              # serve segments/posters/captions/documents through a CDN
# CDN_SIGNING_SECRET=        # required with CDN_BASE_URL (min 32 chars)
# MEDIA_MAX_VIDEO_MB=2048
# MEDIA_MAX_DOCUMENT_MB=50
# MEDIA_MAX_IMAGE_MB=10
# MEDIA_MAX_CAPTION_MB=2
# MEDIA_UPLOAD_URL_TTL_SECONDS=3600
# MEDIA_SIGNED_URL_TTL_SECONDS=900
# MEDIA_PLAYBACK_TTL_SECONDS=7200
# MEDIA_HEARTBEAT_INTERVAL_SECONDS=15
# MEDIA_TELEMETRY_TOLERANCE_SECONDS=2
# MEDIA_PROGRESS_FLUSH_INTERVAL_SECONDS=30
# MEDIA_PROCESS_CONCURRENCY=1
# MEDIA_TRANSCODE_TIMEOUT_SECONDS=10800
# MEDIA_WORK_DIR=            # scratch space for transcodes (default: OS temp dir)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# MALWARE_SCANNER=none       # none | clamav (clamav is the default in staging/production)
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# LESSON_GRANT_SECRET=       # defaults to INTERNAL_AUTH_SECRET
# PLAYBACK_SIGNING_SECRET=   # defaults to a key derived from INTERNAL_AUTH_SECRET
