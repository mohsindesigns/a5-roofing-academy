# Development defaults for the gateway (loaded after the root .env).
PORT=4000
# Generous sign-in limit for local end-to-end test runs (production default: 30/min per IP).
RATE_LIMIT_LOGIN_PER_MINUTE=300
RATE_LIMIT_SENSITIVE_PER_MINUTE=300
# Allow large video uploads through the gateway when using the local storage driver (S3 uploads bypass it).
MAX_UPLOAD_BODY_BYTES=2147483648
