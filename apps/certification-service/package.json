{
  "name": "@a5/certification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=.env.development --watch dist/main.js",
    "start": "node dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=.env.development dist/database/migrate.js latest",
    "db:seed": "node --env-file-if-exists=../../.env --env-file-if-exists=.env.development dist/seed/seed.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a5/auth": "workspace:*",
    "@a5/config": "workspace:*",
    "@a5/contracts": "workspace:*",
    "@a5/database": "workspace:*",
    "@a5/directory": "workspace:*",
    "@a5/events": "workspace:*",
    "@a5/messaging": "workspace:*",
    "@a5/nest-kit": "workspace:*",
    "@a5/observability": "workspace:*",
    "@a5/permissions": "workspace:*",
    "@a5/rules": "workspace:*",
    "@a5/seed-data": "workspace:*",
    "@a5/storage": "workspace:*",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/mrs-saint-delafield": "^0.4.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "express": "^5.1.0",
    "multer": "2.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@a5/testing": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.3.1"
  }
}
