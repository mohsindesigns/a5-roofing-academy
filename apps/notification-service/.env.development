# Development defaults for notification-service (loaded after the root .env).
PORT=4070
DATABASE_URL=postgres://a5:a5_dev_password@127.0.0.1:5432/a5_notification
# Mailpit listens for SMTP on 1025 and shows captured mail at http://127.0.0.1:8025.
# Without SMTP_URL, emails are written to the service log instead (console transport).
# SMTP_URL=smtp://127.0.0.1:1025
