# ---------------------------------------------------------------------------
# A5 Roofing Sales Academy — local development configuration
# Copy to .env (or run `pnpm keys:generate`, which also fills in the secrets).
# Every service reads this file; values specific to one service are noted.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info
SERVICE_ROLE=all
PUBLIC_APP_URL=http://localhost:5173

# Shared infrastructure
REDIS_URL=redis://127.0.0.1:6379
REDIS_NAMESPACE=a5
POSTGRES_ADMIN_URL=postgres://a5:a5_dev_password@127.0.0.1:5432/postgres

# Secrets (generated by `pnpm keys:generate`; never commit real values)
INTERNAL_AUTH_SECRET=
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
STORAGE_SIGNING_SECRET=

# Identity
COOKIE_SECURE=false
EXPOSE_ACTIVATION_LINKS=true

# Service discovery (used by the gateway and service-to-service calls)
IDENTITY_SERVICE_URL=http://127.0.0.1:4010
LEARNING_SERVICE_URL=http://127.0.0.1:4020
MEDIA_SERVICE_URL=http://127.0.0.1:4030
ASSESSMENT_SERVICE_URL=http://127.0.0.1:4040
AI_SERVICE_URL=http://127.0.0.1:4050
CERTIFICATION_SERVICE_URL=http://127.0.0.1:4060
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4070
ANALYTICS_SERVICE_URL=http://127.0.0.1:4080
AUDIT_SERVICE_URL=http://127.0.0.1:4090

# Gateway
CORS_ORIGINS=http://localhost:5173

# Public origin of the API as seen by browsers (used in signed playback/upload URLs). Defaults to PUBLIC_APP_URL.
# PUBLIC_API_URL=http://localhost:5173

# Media (media-service)
MEDIA_MAX_VIDEO_MB=2048
# Malware scanning: `none` (development only) or `clamav` (default in staging/production).
MALWARE_SCANNER=none
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Optional CDN in front of object storage; CDN_SIGNING_SECRET is required when this is set.
# CDN_BASE_URL=
# CDN_SIGNING_SECRET=

# Storage (media + certification). `local` keeps files on disk; `s3` works with MinIO/S3/R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=a5-academy
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=a5minio
S3_SECRET_ACCESS_KEY=a5minio-secret

# Email (notification service). Mailpit UI: http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="A5 Sales Academy <academy@a5roofing.example>"

# AI providers (ai-coaching-service). Without a key the development simulator is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
