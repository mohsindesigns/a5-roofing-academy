{
  "name": "@a5/nest-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@a5/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@a5/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@a5/auth": "workspace:*",
    "@a5/config": "workspace:*",
    "@a5/database": "workspace:*",
    "@a5/events": "workspace:*",
    "@a5/messaging": "workspace:*",
    "@a5/observability": "workspace:*",
    "@a5/permissions": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@a5/testing": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@types/compression": "^1.8.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "pino": "^10.4.0",
    "supertest": "^7.3.1"
  }
}
