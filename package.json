{
  "name": "a5-roofing-academy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @a5/e2e test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:create": "node infra/scripts/create-databases.mjs",
    "db:migrate": "turbo run db:migrate --concurrency=1",
    "db:seed": "turbo run db:seed --concurrency=1",
    "keys:generate": "node infra/scripts/generate-keys.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  }
}
